
<div class="neural-network" data-neural-network>
  <canvas
    class="neural-canvas"
    aria-label="Visualización animada de una red neuronal artificial"
    role="img"
  ></canvas>
  <div class="neural-caption" aria-hidden="true">
    <span>NEURAL NETWORK / 001</span>
    <span class="neural-status">● ACTIVE</span>
  </div>
</div>

<script>
  function initializeNetwork(root: HTMLElement) {
    const canvas = root.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const motionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    type Node = {
      x: number;
      y: number;
      activation: number;
    };

    type Connection = {
      from: Node;
      to: Node;
      phase: number;
    };

    let nodes: Node[] = [];
    let connections: Connection[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let raf = 0;
    let running = false;
    let visible = true;
    let pointer = { x: -1000, y: -1000 };

    const layers = [4, 6, 6, 3];

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);

      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      nodes = [];
      connections = [];

      const grouped: Node[][] = [];

      layers.forEach((count, layerIndex) => {
        const group: Node[] = [];
        const x = width * (0.12 + layerIndex * 0.25);

        for (let i = 0; i < count; i++) {
          const spacing = Math.min(43, height * 0.11);
          const y = height / 2 +
            (i - (count - 1) / 2) * spacing;

          const node = { x, y, activation: 0 };
          nodes.push(node);
          group.push(node);
        }

        grouped.push(group);
      });

      for (let i = 0; i < grouped.length - 1; i++) {
        for (const from of grouped[i]) {
          for (const to of grouped[i + 1]) {
            connections.push({
              from,
              to,
              phase: Math.random()
            });
          }
        }
      }
    }

    function render() {
      ctx!.clearRect(0, 0, width, height);

      const animated = !motionQuery.matches;
      if (animated) frame++;

      // Dibujar conexiones entre neuronas
      for (const connection of connections) {
        const { from, to } = connection;

        ctx!.beginPath();
        ctx!.moveTo(from.x, from.y);
        ctx!.lineTo(to.x, to.y);
        ctx!.strokeStyle = "rgba(0, 212, 255, 0.13)";
        ctx!.lineWidth = 0.8;
        ctx!.stroke();

        if (animated) {
          const progress =
            (frame * 0.003 + connection.phase) % 1;

          const x = from.x + (to.x - from.x) * progress;
          const y = from.y + (to.y - from.y) * progress;

          ctx!.beginPath();
          ctx!.arc(x, y, 1.5, 0, Math.PI * 2);
          ctx!.fillStyle = "rgba(25, 230, 190, 0.65)";
          ctx!.fill();
        }
      }

      // Dibujar neuronas
      for (const node of nodes) {
        const distance = Math.hypot(
          pointer.x - node.x,
          pointer.y - node.y
        );

        const influence = Math.max(0, 1 - distance / 100);

        node.activation = animated
          ? node.activation * 0.88 + influence * 0.12
          : influence;

        const radius = 4 + node.activation * 4;

        ctx!.beginPath();
        ctx!.arc(node.x, node.y, radius + 6, 0, Math.PI * 2);
        ctx!.fillStyle =
          `rgba(0, 212, 255, ${0.025 + node.activation * 0.15})`;
        ctx!.fill();

        ctx!.beginPath();
        ctx!.arc(node.x, node.y, radius, 0, Math.PI * 2);
        ctx!.fillStyle = "#102b40";
        ctx!.fill();

        ctx!.strokeStyle =
          node.activation > 0.1 ? "#19e6be" : "#00d4ff";
        ctx!.lineWidth = 1.5;
        ctx!.stroke();
      }

      if (running && animated) {
        raf = requestAnimationFrame(render);
      }
    }

    function start() {
      if (running || !visible || document.hidden) return;
      running = true;
      render();
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function updateMotion() {
      stop();
      render();
      if (!motionQuery.matches) start();
    }

    canvas.addEventListener("pointermove", (event) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;

      if (motionQuery.matches) render();
    });

    canvas.addEventListener("pointerleave", () => {
      pointer = { x: -1000, y: -1000 };
      if (motionQuery.matches) render();
    });

    const resizeObserver = new ResizeObserver(() => {
      resize();
      if (!running) render();
    });

    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? false;
        if (visible && !motionQuery.matches) start();
        else stop();
      }
    );

    const onVisibilityChange = () => {
      if (document.hidden) stop();
      else if (!motionQuery.matches) start();
    };

    resizeObserver.observe(canvas);
    intersectionObserver.observe(root);
    motionQuery.addEventListener("change", updateMotion);
    document.addEventListener(
      "visibilitychange",
      onVisibilityChange
    );

    resize();
    if (motionQuery.matches) render();
    else start();

    return () => {
      stop();
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      motionQuery.removeEventListener("change", updateMotion);
      document.removeEventListener(
        "visibilitychange",
        onVisibilityChange
      );
    };
  }

  document.querySelectorAll<HTMLElement>(
    "[data-neural-network]"
  ).forEach((root) => {
    initializeNetwork(root);
  });
</script>

<style>
  .neural-network {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 212, 255, 0.07),
      transparent 70%
    );
  }

  .neural-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .neural-caption {
    position: absolute;
    bottom: 16px;
    left: 18px;
    right: 18px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #7e9fb6;
    font: 10px monospace;
    letter-spacing: 1px;
    pointer-events: none;
  }

  .neural-status { color: #19e6be; }

  @media (max-width: 800px) {
    .neural-network { height: 320px; }
  }

  @media (max-width: 480px) {
    .neural-network { height: 260px; }
  }
</style>
